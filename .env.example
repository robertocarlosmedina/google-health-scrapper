# --- PostgreSQL ---
POSTGRES_DB="google_health"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="health"
POSTGRES_PASSWORD="health"

# --- Google OAuth (Google Cloud Console > Credentials > OAuth client ID, type "Desktop app") ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 0 = random port (fine for a "Desktop app" client). If your client is a "Web application" type,
# set a fixed port (e.g. 8080) and register http://localhost:8080/ as an authorized redirect URI.
GOOGLE_OAUTH_PORT=0
# Written by `uv run python main.py auth`, holds the refresh token. Keep it private.
GOOGLE_TOKEN_FILE="token.json"

# --- Scheduler ---
# Run a sync every N minutes (set 0 to disable the built-in scheduler and use system cron with `main.py sync`).
SYNC_INTERVAL_MINUTES=60
# Run one sync immediately on start before waiting for the first interval.
SYNC_ON_START=true

# --- What to scrape ---
# Comma-separated Google Health data types (kebab-case, see https://developers.google.com/health/data-types)
# or "default" for a sensible daily-life set.
SYNC_DATA_TYPES="default"
# How far back the very first sync of each data type goes.
SYNC_INITIAL_LOOKBACK_DAYS=30
# Every sync re-reads this many hours before the last checkpoint, because Fitbit data syncs late. Upserts make this safe.
SYNC_OVERLAP_HOURS=48
# Max time window per request, in days (keeps big backfills paginated in chunks).
SYNC_WINDOW_DAYS=7

LOG_LEVEL=INFO
# MODULE_LOG_LEVELS="scraper.clients=DEBUG,urllib3=WARNING"
